rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /todos/{todoId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
    }

    // Mail + calendar are read live by the client via onSnapshot. All writes
    // go through the Go API (Firebase Admin SDK), which bypasses these rules,
    // so clients get read-only owner-scoped access. Queries MUST filter
    // `where userId == request.auth.uid` to satisfy the rule.
    match /emails/{emailId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    match /events/{eventId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Risk: one active game per user, keyed by uid (riskGames/{uid}) plus a
    // per-user stats aggregate (riskStats/{uid}). Both are read live by the
    // client via onSnapshot — the user can only read their own doc. All
    // writes go through the Go API (Admin SDK bypasses these rules), so the
    // client never writes here directly.
    match /riskGames/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }
    match /riskStats/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }
  }
}
