# Copy to .env and fill in. Vars prefixed with VITE_ are exposed to the browser.

# Mapbox public token for the Risk globe. Public-scope (pk.*) — safe in the
# bundle. Create one at https://account.mapbox.com/access-tokens/.
VITE_MAPBOX_TOKEN=pk.your-public-token-here

# Optional: override the dev API base URL (defaults to http://localhost:4090).
# VITE_API_URL=https://demo.qodo.us
